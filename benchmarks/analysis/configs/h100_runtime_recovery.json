{
  "settings": {
    "fp8": {
      "backend": "triton",
      "scaling_recipe": "current",
      "backward_precision": "native"
    },
    "compression": {
      "bits": 2,
      "group_size": 1024
    },
    "runtime": {
      "binding": "functional",
      "cache_enabled": false,
      "check_finite": false
    }
  },
  "workloads": [
    {
      "name": "projection",
      "op": "linear",
      "shape": [
        4096,
        768
      ],
      "kwargs": {
        "out_features": 3072
      }
    },
    {
      "name": "mlp",
      "op": "linear_pipeline",
      "shape": [
        32,
        197,
        768
      ],
      "kwargs": {
        "out_features": 3072
      }
    },
    {
      "name": "attention_block",
      "op": "attention_pipeline",
      "shape": [
        32,
        197,
        768
      ],
      "kwargs": {
        "num_heads": 12
      }
    }
  ],
  "tolerances": {
    "default": {
      "rtol": 0.05,
      "atol": 0.01
    },
    "gradients": {
      "rtol": 0.05,
      "atol": 1e-06,
      "max_relative_l2": 0.1,
      "min_cosine": 0.99
    },
    "updates": {
      "rtol": 0.05,
      "atol": 1e-07,
      "max_relative_l2": 0.1,
      "min_cosine": 0.99
    }
  },
  "grid": {
    "runtime.scope_lifetime": [
      "fresh",
      "reused"
    ]
  }
}
