{
  "settings": {
    "runtime": {
      "scope_lifetime": "reused",
      "numerical_probe": "random_upstream",
      "execution": "graph"
    }
  },
  "workloads": [
    {
      "name": "bn_large",
      "op": "batch_norm",
      "shape": [
        16,
        64,
        56,
        56
      ],
      "kwargs": {}
    },
    {
      "name": "bn_small",
      "op": "batch_norm",
      "shape": [
        32,
        256,
        7,
        7
      ],
      "kwargs": {}
    },
    {
      "name": "gn_small",
      "op": "group_norm",
      "shape": [
        16,
        128,
        7,
        7
      ],
      "kwargs": {
        "num_groups": 32
      }
    },
    {
      "name": "gn_large",
      "op": "group_norm",
      "shape": [
        16,
        64,
        56,
        56
      ],
      "kwargs": {
        "num_groups": 8
      }
    }
  ],
  "grid": {
    "runtime.norm_kernel_variant": [
      "baseline",
      "batch_shared",
      "small_forward"
    ]
  },
  "tolerances": {
    "default": {
      "rtol": 0.05,
      "atol": 0.01
    },
    "gradients": {
      "rtol": 0.05,
      "atol": 0.000001,
      "max_relative_l2": 0.1,
      "min_cosine": 0.99
    },
    "updates": {
      "rtol": 0.05,
      "atol": 1e-7,
      "max_relative_l2": 0.1,
      "min_cosine": 0.99
    }
  }
}
